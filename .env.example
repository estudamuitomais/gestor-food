# Integração real permanece desligada por padrão.
IFOOD_INTEGRATION_ENABLED=false
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_REQUEST_TIMEOUT_MS=10000

# Proteção de custo: não habilitar sem autorização administrativa.
COSTS_ENABLED=false

# Exigir Bearer token para sincronização e aprovações em produção.
REQUIRE_AUTH=false

# Porta local
PORT=3000
TRUST_PROXY=false

# Persistência de produção (PostgreSQL). Sem DATABASE_URL, o app permanece em MEMORY/DEMO.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
